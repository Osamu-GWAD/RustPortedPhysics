{
    "name": "@nxg-org/mineflayer-physics-util",
    "version": "1.9.10",
    "description": "Provides functionality for more accurate entity and projectile tracking.",
    "keywords": [
        "mineflayer",
        "mineflayer-plugin",
        "mineflayer-tracker"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nxg-org/mineflayer-physics-utils.git"
    },
    "license": "GPL-3.0",
    "author": "generel_schwerz",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "native/index.js",
        "native/index.d.ts",
        "README.md"
    ],
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "lint": "eslint src --ext .ts,.tsx",
        "build": "pnpm build:native && pnpm build:ts",
        "build:ts": "tsc",
        "build:native": "napi build --platform --release --output-dir native --js index.js --dts index.d.ts",
        "build:native:debug": "napi build --platform --output-dir native --js index.js --dts index.d.ts",
        "artifacts": "napi artifacts",
        "bench:native": "node benchmarks/native-overhead.js",
        "bench:simulate": "ts-node benchmarks/simulate-throughput.ts",
        "prepublishOnly": "pnpm build:ts && napi prepublish -t npm",
        "pretest": "pnpm build:native",
        "test": "mocha --require ts-node/register --recursive tests/**/*.test.ts",
        "version": "napi version"
    },
    "dependencies": {
        "@nxg-org/mineflayer-util-plugin": "^1.8.2"
    },
    "optionalDependencies": {
        "@nxg-org/mineflayer-physics-util-darwin-arm64": "1.9.10",
        "@nxg-org/mineflayer-physics-util-darwin-x64": "1.9.10",
        "@nxg-org/mineflayer-physics-util-linux-arm64-gnu": "1.9.10",
        "@nxg-org/mineflayer-physics-util-linux-arm64-musl": "1.9.10",
        "@nxg-org/mineflayer-physics-util-linux-x64-gnu": "1.9.10",
        "@nxg-org/mineflayer-physics-util-linux-x64-musl": "1.9.10",
        "@nxg-org/mineflayer-physics-util-win32-arm64-msvc": "1.9.10",
        "@nxg-org/mineflayer-physics-util-win32-x64-msvc": "1.9.10"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@napi-rs/cli": "^3.9.0",
        "@types/mocha": "^10.0.10",
        "@typescript-eslint/eslint-plugin": "^8.27.0",
        "@typescript-eslint/parser": "^8.27.0",
        "eslint": "^10.10.0",
        "expect": "^29.7.0",
        "globals": "^16.0.0",
        "minecraft-data": "^3.109.0",
        "mineflayer": "github:generelschwerz/mineflayer#dev",
        "mineflayer-pathfinder": "^2.4.4",
        "mocha": "^11.1.0",
        "prismarine-block": "^1.22.0",
        "prismarine-entity": "^2.4.0",
        "prismarine-nbt": "^2.8.0",
        "prismarine-physics": "^1.10.0",
        "prismarine-registry": "^1.11.0",
        "prismarine-world": "^3.6.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vec3": "^0.1.10"
    },
    "napi": {
        "binaryName": "mineflayer_physics_native",
        "targets": [
            "x86_64-pc-windows-msvc",
            "aarch64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-unknown-linux-musl",
            "aarch64-unknown-linux-musl",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
        ]
    }
}
